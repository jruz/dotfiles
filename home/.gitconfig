[user]
	email = javi@jruz.io
	name = jruz
	signingkey = ~/.ssh/codeberg.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[push]
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	rebase = true
[core]
	pager = bat --style=plain --paging=always
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[diff]
	algorithm = histogram
	colorMoved = default
	compactionHeuristic = true
[rerere]
	enabled = true
[commit]
	gpgsign = true
[alias]
	reword = "!f() { old=$(git log --format=%s -n 1 $1); git commit --allow-empty --only -m \"amend! $old\" -m \"$2\"; GIT_SEQUENCE_EDITOR=: git rebase --interactive --autosquash $1~1; }; f"
[credential "https://github.com"]
	helper = 
	helper = !/Users/jruz/.nix-profile/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/Users/jruz/.nix-profile/bin/gh auth git-credential
