[user]
	email = javi@jruz.io
	name = jruz
	signingkey = ~/.ssh/codeberg.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[push]
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	rebase = true
[core]
	pager = bat --style=plain --paging=always
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[diff]
	algorithm = histogram
	colorMoved = default
	compactionHeuristic = true
[rerere]
	enabled = true
[hook "git-hook-pre-commit"]
	event = pre-commit
	command = ~/.local/bin/git-hook-pre-commit
[hook "git-hook-post-rewrite"]
	event = post-rewrite
	command = ~/.local/bin/git-hook-post-rewrite
[hook "git-hook-post-merge"]
	event = post-merge
	command = ~/.local/bin/git-hook-post-merge
[commit]
	gpgsign = true
[alias]
	reword = "!f() { old=$(git log --format=%s -n 1 $1); git commit --allow-empty --only -m \"amend! $old\" -m \"$2\"; GIT_SEQUENCE_EDITOR=: git rebase --interactive --autosquash $1~1; }; f"
[credential]
	helper =
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/
