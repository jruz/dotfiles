#!/usr/bin/env nu

use std/log

# Send a notification to ntfy channels.
def main [
    target: string # mobile, desktop, or all.
    --title: string # Required notification title.
    --message: string # Required notification body.
]: nothing -> nothing {
    let notification = if $title != null and $message != null {
        {title: $title, message: $message}
    } else {
        let missing = if $title == null { '--title' } else { '--message' }
        log error $"($missing) is required"
        exit 1
    }
    let channels = match $target {
        "mobile" => [$env.NTFY_CHANNEL_MOBILE]
        "desktop" => [$env.NTFY_CHANNEL_DESKTOP]
        "all" => [$env.NTFY_CHANNEL_MOBILE $env.NTFY_CHANNEL_DESKTOP]
        _ => {
            log error "target must be mobile, desktop, or all"
            exit 1
        }
    }
    for channel in $channels {
        let body = {topic: $channel, ...$notification} | to json --raw
        http post --content-type application/json https://ntfy.sh $body
    }
}
