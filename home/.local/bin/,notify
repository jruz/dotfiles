#!/usr/bin/env nu

# Send a message to ntfy channels.
def main [
    target: string # Channel group: mobile, desktop, or all.
    message: string # Message body to send.
] {
    let channels = match $target {
        "mobile" => [$env.NTFY_CHANNEL_MOBILE]
        "desktop" => [$env.NTFY_CHANNEL_DESKTOP]
        "all" => [$env.NTFY_CHANNEL_MOBILE $env.NTFY_CHANNEL_DESKTOP]
        _ => {
            print --stderr "ERROR: target must be mobile, desktop, or all"
            exit 1
        }
    }
    for channel in $channels {
        http post $"https://ntfy.sh/($channel)" $message
    }
}
