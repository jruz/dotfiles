#!/usr/bin/env nu

use std/log

const INFO = {SeverityText: INFO, SeverityNumber: 9}

def emit-log [body: string, attributes: record]: nothing -> nothing {
    log info ({
        Timestamp: (date now | format date "%+")
        ...$INFO
        Body: $body
        Attributes: $attributes
    } | to json --raw)
}

def app [args: list<string>]: nothing -> record {
    emit-log app {args: $args}
    let output = ^herdr-app ...$args
    $output | from json
}

def ancestors [processes: table, pid: int]: nothing -> list<int> {
    if $pid <= 1 { return [] }
    let parent = ($processes | where pid == $pid | get ppid | into int | first)
    [$pid] | append (ancestors $processes $parent)
}

def matching-tabs [parents: list<int>]: nothing -> list<record> {
    emit-log find-tab {parents: $parents}
    let tabs = ((app [ls]).spaces
        | where machine == null
        | get tabs
        | flatten)
    mut matches = []
    for tab in $tabs {
        for terminal in $tab.terminals {
            let output = ^hc get $terminal.terminal
            let details = ($output | from json)
            if $details.foreground?.pid? in $parents {
                $matches ++= [
                    {id: $tab.id, label: $details.labels."herdr.tab"?}
                ]
            }
        }
    }
    $matches
}

# Rename the Herdr tab that owns this process.
def main [
    title: string # New tab title.
]: nothing -> nothing {
    emit-log main {title: $title}
    if ($title | str trim | is-empty) {
        log error "provide a non-empty title"
        exit 1
    }
    let output = ^ps -axo pid=,ppid=
    let processes = ($output | detect columns --no-headers | rename pid ppid | into int pid ppid)
    let parents = (ancestors $processes $nu.pid)
    let matches = matching-tabs $parents
    if ($matches | length) != 1 {
        log error "could not uniquely identify this process's Herdr tab"
        exit 1
    }
    let tab = ($matches | first)
    if $tab.label != $tab.id {
        log error "Herdr tab label does not match the app's tab ID"
        exit 1
    }
    emit-log rename-tab {tab: $tab, title: $title}
    app [do tab.rename ({id: $tab.id, name: $title} | to json --raw)]
    let actual = (app [ls]
        | get spaces.tabs
        | flatten
        | where id == $tab.id
        | get name
        | first)
    if $actual != $title {
        log error "Herdr did not retain the requested title"
        exit 1
    }
    print $actual
}
