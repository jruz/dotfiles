#!/usr/bin/env nu

const INFO = {SeverityText: INFO, SeverityNumber: 9}

def emit-log [body: string, attributes: record] {
    print --stderr ({
        Timestamp: (date now | format date "%+")
        ...$INFO
        Body: $body
        Attributes: $attributes
    } | to json --raw)
}

def parse-result []: record -> record {
    let result = $in
    if $result.exit_code != 0 {
        error make {msg: $"command failed: ($result.stderr)($result.stdout)"}
    }
    $result.stdout | from json
}

def app [args: list<string>]: nothing -> record {
    emit-log app {args: $args}
    ^herdr-app ...$args | complete | parse-result
}

def ancestors [processes: table, pid: int]: nothing -> list<int> {
    if $pid <= 1 { return [] }
    let parent = ($processes | where pid == $pid | get ppid | into int | first)
    [$pid] | append (ancestors $processes $parent)
}

def find-tab [parents: list<int>]: nothing -> record {
    emit-log find-tab {parents: $parents}
    let matches = ((app [ls]).spaces
        | where machine == null
        | get tabs
        | flatten
        | each {|tab|
            $tab.terminals
            | each {|terminal|
                let details = (^hc get $terminal.terminal | complete | parse-result)
                if $details.foreground?.pid? in $parents {
                    {id: $tab.id, label: $details.labels."herdr.tab"?}
                }
            }
        }
        | flatten)
    if ($matches | length) != 1 {
        error make {msg: "could not uniquely identify this process's Herdr tab"}
    }
    let tab = ($matches | first)
    if $tab.label != $tab.id {
        error make {msg: "Herdr tab label does not match the app's tab ID"}
    }
    $tab
}

def rename-tab [tab: record, title: string] {
    emit-log rename-tab {tab: $tab, title: $title}
    app [do tab.rename ({id: $tab.id, name: $title} | to json --raw)]
    let actual = (app [ls]
        | get spaces.tabs
        | flatten
        | where id == $tab.id
        | get name
        | first)
    if $actual != $title {
        error make {msg: "Herdr did not retain the requested title"}
    }
    print $actual
}

# Rename the Herdr tab that owns this process.
def main [
    title: string # New tab title.
]: nothing -> nothing {
    emit-log main {title: $title}
    if ($title | str trim | is-empty) {
        print --stderr "ERROR: provide a non-empty title"
        exit 1
    }
    try {
        let processes = (^ps -axo pid=,ppid= | detect columns --no-headers | rename pid ppid | into int pid ppid)
        let parents = (ancestors $processes $nu.pid)
        rename-tab (find-tab $parents) $title
    } catch {|err|
        print --stderr $"ERROR: ($err.msg)"
        exit 1
    }
}
