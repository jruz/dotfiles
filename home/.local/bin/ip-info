#!/usr/bin/env nu
# vim: ft=nu

def is-osx []: nothing -> bool {
    (uname).kernel-name == "Darwin"
}

def fetch-json [url: string]: nothing -> record {
    http get --max-time 10sec --headers [Accept application/json] $url
}

def main []: nothing -> record<"public ip": string, "local ip": string, location: string, dns: string> {
    let info = (fetch-json https://ipinfo.io)

    let local_ip = if (is-osx) {
        try { ^ipconfig getifaddr en0 | str trim } catch { try { ^ipconfig getifaddr en1 | str trim } catch { "not connected" } }
    } else {
        ^hostname -I | split row " " | first
    }

    let dns = if (is-osx) {
        ^scutil --dns | lines | find "nameserver[0]" | first | split row ":" | last | str trim
    } else {
        open /etc/resolv.conf | lines | find nameserver | first | split row " " | last
    }

    let resp = (fetch-json https://test.nextdns.io)
    let nextdns = if $resp.status == "ok" {
        $"($resp.protocol) \(($resp.server)\) 🔒"
    } else {
        $"($resp.status) ⚠️"
    }

    {
        "public ip": $info.ip
        "local ip": $local_ip
        location: $"($info.city), ($info.region), ($info.country)"
        dns: $"($dns) → ($nextdns)"
    }
}
