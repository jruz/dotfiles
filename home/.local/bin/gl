#!/usr/bin/env nu

def format-commit [width: int, color: string]: record -> string {
    let commit = $in
    let committer = ($commit.committer | fill --width $width)
    if $color != 'always' {
        return $'($commit.prefix)($committer) | ($commit.subject)($commit.age)'
    }
    let is_dependency = ($commit.subject | str starts-with '[deps]')
    let foreground = if $is_dependency { ansi dark_gray } else { ansi reset }
    let prefix = if $is_dependency {
        $commit.prefix | str replace (ansi blue) (ansi dark_gray)
    } else {
        $commit.prefix
    }
    $"($prefix)($foreground)($committer)(ansi reset) | ($foreground)($commit.subject)(ansi dark_gray)($commit.age)(ansi reset)"
}

def --wrapped main [...args: string]: nothing -> nothing {
    let color = if (is-terminal --stdout) { 'always' } else { 'auto' }
    let result = (^git log $'--color=($color)' --pretty=format:'%C(brightblack)%ad%C(reset) | %C(blue)%h%C(reset) | %x1f%cn%x1f%s%x1f (%ar)' --date=short --max-count=20 ...$args | complete)
    if $result.exit_code != 0 {
        print --stderr --no-newline $result.stderr
        exit $result.exit_code
    }

    let lines = ($result.stdout | lines)
    let commits = ($lines
        | parse --regex '^(?<prefix>[^\x1f]*)\x1f(?<committer>[^\x1f]*)\x1f(?<subject>[^\x1f]*)\x1f(?<age>.*)$')
    if ($commits | length) != ($lines | length) {
        print --stderr 'gl: Git output format is unsupported; remove output-changing flags such as --oneline, --stat, or --patch'
        exit 1
    }

    if ($commits | is-empty) {
        return
    }

    let width = ($commits
        | each { get committer | str length }
        | math max)
    $commits
    | each { format-commit $width $color }
    | str join (char newline)
    | print
}
