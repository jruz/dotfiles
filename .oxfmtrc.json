{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/",
    ".clj-kondo/",
    "home/.config/nvim/nvim-pack-lock.json",
    "home/.config/herdr-app/frame/",
    "home/.config/herdr-app/mods/",
    "home/.config/herdr-app/*.d.ts",
    "home-mac/Brewfile.lock.json",
    "tmp/",
    "node_modules/",
    "pnpm-lock.yaml",
    "target/"
  ]
}
