{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/",
    ".clj-kondo/",
    "home/",
    "home-mac/",
    "home-linux/",
    "mac/",
    "ubuntu/",
    "windows/",
    "tmp/",
    "node_modules/",
    "pnpm-lock.yaml",
    "*.md"
  ]
}
