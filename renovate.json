{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^home/\\.config/home-manager/flake\\.nix$/"],
      "matchStrings": [
        "(?<depName>[\\w-]+) = \\{\\s*url = \"github:(?<packageName>jruz/[\\w-]+|pimalaya/calendula|tree-sitter/tree-sitter)\\?ref=(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/\\.config/home-manager/packages/claude\\.nix$/"
      ],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "claude",
      "packageNameTemplate": "@anthropic-ai/claude-code",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/\\.config/home-manager/packages/codex\\.nix$/"
      ],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "codex",
      "packageNameTemplate": "openai/codex",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^rust-v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/\\.config/home-manager/packages/herdr-core\\.nix$/"
      ],
      "matchStrings": ["version = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "herdr-core",
      "datasourceTemplate": "custom.herdr-core"
    }
  ],
  "customDatasources": {
    "herdr-core": {
      "defaultRegistryUrlTemplate": "https://releases.herdr.dev/core/latest.json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    }
  },
  "rangeStrategy": "pin",
  "semanticCommits": "disabled",
  "commitMessagePrefix": "[deps] {{{depName}}}:",
  "commitMessageTopic": "",
  "commitMessageLowerCase": "never",
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["jruz/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": ["@anthropic-ai/claude-code"],
      "followTag": "stable"
    },
    {
      "matchDatasources": ["custom.herdr-core"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["home/.config/home-manager/flake.nix"],
      "postUpgradeTasks": {
        "installTools": {
          "nix": {}
        },
        "commands": [
          "nix --extra-experimental-features 'nix-command flakes' flake update {{{depName}}} --flake ./home/.config/home-manager"
        ],
        "fileFilters": ["home/.config/home-manager/flake.lock"],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["home/.config/home-manager/packages/*.nix"],
      "postUpgradeTasks": {
        "installTools": {
          "nix": {}
        },
        "commands": [
          "nix --extra-experimental-features 'nix-command flakes' run github:NixOS/nixpkgs/nixos-26.05#nushell -- scripts/renovate-package-hashes.nu {{{depName}}}"
        ],
        "fileFilters": ["home/.config/home-manager/packages/*.nix"],
        "executionMode": "update"
      }
    },
    {
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "Bun",
      "groupSlug": "bun",
      "separateMajorMinor": false,
      "commitMessagePrefix": "[deps] Bun:",
      "commitMessageAction": "Update",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "dependencies"
      }
    },
    {
      "matchPackageNames": ["oxlint", "@oxlint/plugins", "oxlint-tsgolint"],
      "groupName": "Oxlint",
      "groupSlug": "oxlint",
      "separateMajorMinor": false,
      "commitMessagePrefix": "[deps] Oxlint:",
      "commitMessageAction": "Update",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "dependencies"
      }
    }
  ]
}
