{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^home/\\.config/home-manager/flake\\.nix$/"],
      "matchStrings": [
        "(?<depName>[\\w-]+) = \\{\\s*url = \"github:(?<packageName>jruz/[\\w-]+|pimalaya/calendula|tree-sitter/tree-sitter)\\?ref=(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "rangeStrategy": "pin",
  "semanticCommits": "disabled",
  "commitMessagePrefix": "[deps] {{{depName}}}:",
  "commitMessageTopic": "",
  "commitMessageLowerCase": "never",
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["jruz/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["custom.regex"],
      "postUpgradeTasks": {
        "installTools": {
          "nix": {}
        },
        "commands": [
          "nix --extra-experimental-features 'nix-command flakes' flake update {{{depName}}} --flake ./home/.config/home-manager"
        ],
        "fileFilters": ["home/.config/home-manager/flake.lock"],
        "executionMode": "update"
      }
    },
    {
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "Bun",
      "groupSlug": "bun",
      "separateMajorMinor": false,
      "commitMessagePrefix": "[deps] Bun:",
      "commitMessageAction": "Update",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "dependencies"
      }
    },
    {
      "matchPackageNames": ["oxlint", "@oxlint/plugins", "oxlint-tsgolint"],
      "groupName": "Oxlint",
      "groupSlug": "oxlint",
      "separateMajorMinor": false,
      "commitMessagePrefix": "[deps] Oxlint:",
      "commitMessageAction": "Update",
      "commitMessageExtra": "",
      "group": {
        "commitMessageTopic": "dependencies"
      }
    }
  ]
}
