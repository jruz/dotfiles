      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "Rust": {
      "show_edit_predictions": true
    },
    "Nix": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": ["-"]
        }
      }
    },
    "Python": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"]
        }
      }
    },
    "Jinja2": {
      "format_on_save": "on",
      "formatter": "prettier"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
          "extraArgs": [
            "--",
            "-W",
            "clippy::pedantic",
            "-D",
            "clippy::unwrap_used"
          ]
        },
        "checkOnSave": true
      }
    }
  }
}
