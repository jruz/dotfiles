// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "auto_install_extensions": {
    "oxc": true
  },
  "ssh_connections": [
    {
      "host": "minisforum",
      "args": [],
      "projects": []
    }
  ],
  "project_panel": {
    "dock": "left"
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    }
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": ["registry.jruz.io"]
    },
    "profiles": {
      "yolo": {
        "name": "Yolo",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b"
            }
          ]
        },
        "skill": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-6.1-sol",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "threads_sidebar": {
      "position": "right"
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-6-luna"
    }
  },
  "telemetry": {
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "tab_size": 2,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "terminal": {
    "dock": "right",
    "font_family": "DejaVuSansM Nerd Font",
    "font_size": 12,
    "max_scroll_history_lines": 100000
  },
  "code_actions_on_format": {},
  "soft_wrap": "editor_width",
  "file_types": {
    "HTML": ["htm", "html"],
    "Jinja2": ["htmx"],
    "JSON": ["prettierrc"]
  },
  "formatter": "auto",
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "oxfmt", "!biome", "!eslint", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "JSX": {
      "language_servers": ["oxlint", "oxfmt", "!biome", "!eslint", "..."],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TypeScript": {
      "language_servers": ["oxlint", "oxfmt", "!biome", "!eslint", "..."],
