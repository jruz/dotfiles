{
  "name": "dotfiles",
  "scripts": {
    "knip-check": "knip",
    "knip-production-check": "knip --production",
    "oxfmt-check": "oxfmt --check",
    "oxlint-check": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error .",
    "oxlint-rules-check": "node --test .oxlint/*.test.ts",
    "renovate-check": "node --require re2 ./node_modules/renovate/dist/config-validator.js --strict renovate.json",
    "tsc-check": "tsc"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "re2": "1.27.0",
    "renovate": "44.192.1",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.4",
    "node": "26.13.0",
    "pnpm": "11.28.9"
  },
  "dependencies": {
    "@bgotink/kdl": "0.4.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
