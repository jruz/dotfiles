def make-icon [code: int]: nothing -> string { char --integer $code }

def replacements []: nothing -> list<list<string>> {
  $ICON_CODES | each {|row| [$row.0 (make-icon $row.1)] }
}

def "main debug-icons" []: nothing -> nothing {
  print "\nIcon Debug Output:"
  print "=================="

  for row in (replacements) {
    let placeholder = $row.0
    let icon = $row.1
    let length = ($icon | str length)
    let bytes = ($icon | into binary | length)

    print $"\n($placeholder):
  Value: '($icon)'
  Length: ($length) chars
  Bytes: ($bytes)"
  }
}

def main []: nothing -> nothing {
  let repo_root = $env.PWD
  let skill_dir = ($repo_root | path join ".claude" "skills" "starship")
  let target_file = ($repo_root | path join "home" ".config" "starship.toml")

  let template = open --raw ($skill_dir | path join "starship.toml")

  let result = replacements | reduce --fold $template {|row, acc|
    $acc | str replace --all $row.0 $row.1
  }

  $result | save --force $target_file
  print $"✓ Wrote ($result | str length) bytes to ($target_file)"
  print "  Icons converted from unicode code points (using your original icon set)"
}
