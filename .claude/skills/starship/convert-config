def debug-icons [] {
  print "\nIcon Debug Output:"
  print "=================="

  for row in $replacements {
    let placeholder = $row.0
    let icon = $row.1
    let length = ($icon | str length)
    let bytes = ($icon | into binary | length)

    print $"\n($placeholder):"
    print $"  Value: '($icon)'"
    print $"  Length: ($length) chars"
    print $"  Bytes: ($bytes)"
  }
}

let result = $replacements | reduce --fold $template {|row, acc|
  $acc | str replace --all $row.0 $row.1
}

$result | save --force $target_file
print $"✓ Wrote ($result | str length) bytes to ($target_file)"
print "  Icons converted from unicode code points (using your original icon set)"
