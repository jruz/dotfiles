#!/usr/bin/env nu

def warn [message: string] {
  print ""
  print $"[(ansi yellow)WARN(ansi reset)] ($message)"
  print ""
}

let changed_files = ^git diff-tree -r --name-only ORIG_HEAD HEAD | lines

if ($changed_files | any {|file| $file | str starts-with "home/.config/home-manager/"}) {
  warn "Home Manager files changed — run: just nix-hm-switch"
}
